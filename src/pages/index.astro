---
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Mark from '../components/Mark.astro';
import SectionHead from '../components/SectionHead.astro';
import SectionJump from '../components/SectionJump.astro';
import Timeline from '../components/Timeline.astro';
import VisualSlot from '../components/VisualSlot.astro';
import { events, formatLong, formatShort, lastUpdated, type RecordEvent } from '../data/record';

import researchArt from '../assets/art/research.png';
import warningsArt from '../assets/art/warnings.png';
import oversightArt from '../assets/art/oversight.png';

/** Look up a record entry by its source URL; fail the build if it is missing. */
const entry = (url: string): RecordEvent => {
  const found = events.find((event) => event.url === url);
  if (!found) throw new Error(`index.astro: no record entry for ${url}`);
  return found;
};

const interview = entry('https://www.pbs.org/video/could-ai-build-a-bioweapon-ugzlxh/');

const sequence = [
  {
    label: 'The development',
    heading: ['What', 'happened'],
    body: 'Start with the dated event, such as a paper, a company incident report, or a government order. Name the source and state its claim.',
  },
  {
    label: 'The evidence',
    heading: ['What the', 'evidence shows'],
    body: 'Separate a controlled test from a real incident. Check the methods, the underlying data, any outside review, and the limits the authors state.',
  },
  {
    label: 'The open questions',
    heading: ['What remains', 'uncertain'],
    body: 'A warning can be serious while its likelihood stays unclear. Record disputed readings, missing evidence, and the gap between what a model could do and observed harm.',
  },
];

const coverage = [
  {
    label: 'Research',
    title: 'Safety research',
    body: 'Studies by labs and independent researchers that test what models can do and how well safeguards hold.',
  },
  {
    label: 'Incidents',
    title: 'Reported incidents',
    body: 'Reported misuse, model failures, and lawsuits, with who reported them and what is still unknown.',
  },
  {
    label: 'Warnings',
    title: 'Public warnings',
    body: 'Open letters, statements, essays, interviews, resignations, and reporting on warnings about AI risk.',
  },
  {
    label: 'Governance',
    title: 'Policy & oversight',
    body: 'Government actions, international declarations, company safety rules, and policy proposals.',
  },
];

const faq = [
  {
    q: 'What counts as a source?',
    a: [
      'Entries link to research papers, company reports, public statements, government documents, court filings, or named news outlets.',
      "A company report gives the company's own findings. A preprint may not have finished peer review. Every entry shows its source type.",
      'Follow the link to read the original and judge the evidence yourself.',
    ],
  },
  {
    q: 'Does a warning establish harm?',
    a: [
      'Warnings describe possible harms and the reasons for concern. They can prompt safeguards before any incident occurs.',
      'An evaluation can show a capability under test conditions. That alone does not show the harm happened in the world.',
    ],
  },
  {
    q: 'How are disagreements handled?',
    a: [
      'The record carries critical analysis next to warnings. Authors can agree a risk deserves attention and still disagree about its likelihood, the evidence, or the best response.',
      'Each entry names who is speaking and keeps their reading apart from what was observed.',
      'Read more than one source before treating an account as settled.',
    ],
  },
  {
    q: 'How current is this record?',
    a: [
      `The record holds ${events.length} selected entries, and the newest is dated ${formatLong(lastUpdated)}. It does not track events as they happen.`,
      'It covers AI safety and security: research and evaluations, reported incidents, public warnings and statements, and policy. The record began with AI and biological risk.',
      'Each entry shows its publication date. Follow its link for revisions or later developments.',
    ],
  },
];

// Selected reading: our own card copy, with date, category and source taken
// from the record entry each card links to.
const reading = [
  {
    event: entry('https://arxiv.org/abs/2506.13798'),
    title: 'When biological capability raises risk',
    summary: 'A research preprint argues that model guidance can increase biological risk. Its dialogues do not demonstrate an attack.',
    art: researchArt,
  },
  {
    event: entry('https://thebulletin.org/2026/07/ai-executives-worry-about-their-technologies-aiding-bioterrorists-how-likely-is-that/'),
    title: 'Examining the public warnings',
    summary: 'The Bulletin of the Atomic Scientists examines executive warnings and the evidence behind them.',
    art: warningsArt,
  },
  {
    event: entry('https://www.rand.org/pubs/research_reports/RRA4999-1.html'),
    title: 'Building layers of biosecurity',
    summary: 'A RAND policy report proposes mutually reinforcing safeguards for the AI era.',
    art: oversightArt,
  },
];

// Conceptual diagram (viewBox 680 x 560). The curves start at the axis origin
// and illustrate a relationship only; there is no measured data behind them.
const AX = { x0: 129, x1: 676, y0: 520, y1: 6 };
const START = { x: AX.x0, y: 505 };
const END_X = 666;
const CLAIMS_END = 57;
const EVIDENCE_END = 443;

const curve = (endY: number, shape: (t: number) => number) => {
  const pts: string[] = [];
  for (let i = 0; i <= 60; i++) {
    const t = i / 60;
    const x = START.x + (END_X - START.x) * t;
    const y = START.y - (START.y - endY) * shape(t);
    pts.push(`${x.toFixed(1)} ${y.toFixed(1)}`);
  }
  return `M${pts.join('L')}`;
};

const K = 4;
const claimsPath = curve(CLAIMS_END, (t) => (Math.exp(K * t) - 1) / (Math.exp(K) - 1));
const evidencePath = curve(EVIDENCE_END, (t) => Math.pow(t, 1.25));

const xTicks = Array.from({ length: 21 }, (_, i) => ({
  x: AX.x0 + ((AX.x1 - AX.x0) * i) / 20,
  major: i % 5 === 0,
}));
const yTicks = Array.from({ length: 21 }, (_, i) => ({
  y: AX.y0 - ((AX.y0 - AX.y1) * i) / 20,
  major: i % 5 === 0,
}));
const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(2)}%`;
---
<BaseLayout>
  <!-- Hero -->
  <section class="hero" data-section="Keeping watch on AI" aria-labelledby="hero-title">
    <div class="hero-visual" style="--focus: 62% 48%">
      <VisualSlot name="hero" />
    </div>
    <div class="wrap hero-inner">
      <h1 id="hero-title">Keeping watch on AI</h1>
      <p class="lead hero-lead">A dated record of AI safety and security research, incidents, warnings, and policy. Each entry links its original source and separates what happened from what remains uncertain.</p>
      <div class="hero-actions">
        <a class="button button-primary" href="/latest">Explore latest</a>
        <a class="button frame" href="/timeline">Browse timeline</a>
      </div>
    </div>
  </section>

  <hr class="rule" />

  <!-- Featured interview -->
  <section class="interview" data-section="Featured interview" data-keywords="video pbs" aria-labelledby="interview-title">
    <div class="wrap interview-grid">
      <div class="interview-media">
        <a
          class="interview-thumb frame"
          href={interview.url}
          target="_blank"
          rel="noopener noreferrer"
          tabindex="-1"
          aria-hidden="true"
        >
          <span class="thumb-art">
            {/* sizes = rendered width: gutters 24px / 120px below 1024; two columns above
                ((100vw - 240px gutters - 48px gap) / 2 - 32px padding), capped at 537px.
                1540w covers the 768px-wide one-column thumb at DPR 2. */}
            <Picture
              src={warningsArt}
              alt=""
              widths={[360, 560, 800, 1100, 1540]}
              sizes="(max-width: 767px) calc(100vw - 48px), (max-width: 1023px) calc(100vw - 240px), min(537px, 50vw - 176px)"
              formats={['webp']}
              fallbackFormat="webp"
              quality={80}
              loading="lazy"
            />
            <span class="thumb-shade"></span>
            <span class="thumb-play">
              <svg width="14" height="16" viewBox="0 0 14 16"><path d="M1 1.5v13L13 8z" fill="currentColor" /></svg>
            </span>
          </span>
          <span class="thumb-caption">
            <span class="thumb-badge">26:46 · Watch at PBS ↗</span>
            <span class="thumb-mark"><Mark size={16} /></span>
          </span>
        </a>
      </div>
      <div class="interview-copy">
        <h2 id="interview-title" class="interview-title">Could AI build a bioweapon? A GZERO World interview examines the risks, the warnings, and the questions still open</h2>
        <div class="interview-meta">
          <p>Featured interview · <time datetime={interview.date}>{formatShort(interview.date)}</time></p>
          <p class="interview-source">
            GZERO World / PBS · <a href={interview.url} target="_blank" rel="noopener noreferrer">Watch at PBS <span aria-hidden="true">↗</span><span class="visually-hidden"> (opens pbs.org in a new tab)</span></a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <hr class="rule" />

  <!-- Why the record matters: conceptual diagram + introduction -->
  <section class="manifesto" data-section="Why evidence matters" aria-label="Why evidence matters">
    <div class="wrap manifesto-grid">
      <figure class="diagram">
        <svg
          class="diagram-svg"
          viewBox="0 0 680 560"
          role="img"
          aria-label="Conceptual diagram of claims, public evidence, and open questions. The curves illustrate a relationship and do not represent measured data."
        >
          <line class="axis" x1={AX.x0} y1={AX.y1} x2={AX.x0} y2={AX.y0} />
          <line class="axis" x1={AX.x0} y1={AX.y0} x2={AX.x1} y2={AX.y0} />
          {xTicks.map((t) => <line class="tick" x1={t.x} y1={AX.y0 + 4} x2={t.x} y2={AX.y0 + (t.major ? 12 : 8)} />)}
          {yTicks.map((t) => <line class="tick" x1={AX.x0 - (t.major ? 12 : 8)} y1={t.y} x2={AX.x0 - 4} y2={t.y} />)}
          <path class="curve curve-evidence" d={evidencePath} />
          <path class="curve curve-claims" d={claimsPath} />
          <circle class="dot-claims" cx={END_X} cy={CLAIMS_END} r="4.6" />
          <circle class="dot-evidence" cx={END_X} cy={EVIDENCE_END} r="4.6" />
          <g class="gap-arrow">
            <line x1={END_X} y1={CLAIMS_END + 18} x2={END_X} y2={EVIDENCE_END - 18} />
            <path d={`M${END_X - 4.1} ${CLAIMS_END + 22.1}L${END_X} ${CLAIMS_END + 18}L${END_X + 4.1} ${CLAIMS_END + 22.1}`} />
            <path d={`M${END_X - 4.1} ${EVIDENCE_END - 22.1}L${END_X} ${EVIDENCE_END - 18}L${END_X + 4.1} ${EVIDENCE_END - 22.1}`} />
          </g>
        </svg>
        <div class="diagram-labels" aria-hidden="true">
          <span class="d-label d-claims" style={`right: ${pct(680 - END_X, 680)}; bottom: ${pct(560 - CLAIMS_END + 14, 560)}`}>Claims and capabilities<br />under discussion</span>
          <span class="d-label d-evidence" style={`right: ${pct(680 - END_X, 680)}; top: ${pct(EVIDENCE_END + 14, 560)}`}>Evidence available<br />for public scrutiny</span>
          <span class="d-label d-gap" style={`right: ${pct(680 - END_X + 10, 680)}; top: ${pct((CLAIMS_END + EVIDENCE_END) / 2, 560)}`}>Questions still open</span>
          <span class="d-axis d-axis-y" style={`left: ${pct(AX.x0 - 22, 680)}; bottom: ${pct(560 - AX.y0, 560)}`}>Conceptual diagram</span>
          <span class="d-axis d-axis-x" style={`left: ${pct(AX.x0, 680)}; top: ${pct(AX.y0 + 22, 560)}`}>Developments</span>
        </div>
      </figure>
      <div class="manifesto-copy">
        <p><span class="dropcap frame" aria-hidden="true"><span>P</span></span><span class="visually-hidden">P</span>ublic understanding of AI risk depends on evidence people can examine. Research, company reports, interviews, and policy proposals often describe different things: an evaluated capability, a possible future harm, or a reported incident. The record keeps them apart.</p>
        <p>SafeAI.watch records public claims about AI safety and security and links each entry to the person or institution making it.</p>
        <p>Read the source, check what was observed, and note what is still unresolved. The diagram is conceptual and has no measured scale.</p>
      </div>
    </div>
  </section>

  <!-- 01 From event to evidence -->
  <section class="sequence" data-seq data-section="From event to evidence" aria-labelledby="sequence-title">
    <div class="wrap block-head">
      <SectionHead
        num="01"
        label="How we read the record"
        id="sequence-title"
        heading="From event to evidence"
        lead="Every entry separates what happened, what the evidence supports, and what remains uncertain."
      />
    </div>
    <div class="sequence-grid">
      <ol class="sequence-steps">
        {sequence.map((step, i) => (
          <li class="sequence-step">
            <article class="step-card frame" data-seq-step data-active={i === 0 ? '' : undefined}>
              <p class="eyebrow step-label">{step.label}</p>
              <h3 class="step-title">{step.heading[0]}<br />{step.heading[1]}</h3>
              <p class="step-body">{step.body}</p>
            </article>
          </li>
        ))}
      </ol>
      <div class="sequence-visual">
        <div class="sequence-visual-pin" style="--focus: 50% 50%">
          <VisualSlot name="sequence" />
        </div>
      </div>
    </div>
  </section>

  <!-- 02 The public record -->
  <div class="record-band" data-section="The public record" data-keywords="timeline dates">
    <div class="record-visual">
      <VisualSlot name="record" tone="dark" />
    </div>
    <div class="record-inner">
      <Timeline eyebrow="02 · The public record" id="home-timeline" />
    </div>
  </div>

  <!-- 03 Four ways to follow the record -->
  <section class="coverage" data-section="Four ways to follow the record" aria-labelledby="coverage-title">
    <div class="wrap">
      <SectionHead
        num="03"
        label="Areas of coverage"
        id="coverage-title"
        heading={'Four ways to\nfollow the record'}
        lead="Every entry in the record falls into one of four areas."
      />
      <div class="coverage-grid">
        <ul class="coverage-list">
          {coverage.map((area) => (
            <li class="coverage-card frame">
              <p class="eyebrow">{area.label}</p>
              <h3 class="coverage-title">{area.title}</h3>
              <p class="coverage-body">{area.body}</p>
            </li>
          ))}
        </ul>
        <div class="coverage-panel">
          <VisualSlot name="coverage" tone="dark" />
        </div>
      </div>
    </div>
  </section>

  <!-- 04 FAQ -->
  <section class="faq" data-section="Reading with care" aria-labelledby="faq-title">
    <div class="wrap">
      <SectionHead
        num="04"
        label="FAQ"
        id="faq-title"
        heading="Reading with care"
        lead="A few distinctions that help when reading about AI safety and security."
      />
      <div class="faq-list">
        {faq.map((item) => (
          <details class="faq-item">
            <summary class="faq-q">
              <span>{item.q}</span>
              <span class="faq-icon" aria-hidden="true"></span>
            </summary>
            <div class="faq-a">
              {item.a.map((para) => <p>{para}</p>)}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 05 From the research log -->
  <section class="reading" data-section="From the research log" aria-labelledby="reading-title">
    <div class="wrap">
      <SectionHead num="05" label="Selected reading" id="reading-title" heading="From the research log">
        <a class="button frame reading-all" href="/latest">Browse latest</a>
      </SectionHead>
      <ul class="reading-grid">
        {reading.map((card) => (
          <li>
            <a class="reading-card" href={card.event.url} target="_blank" rel="noopener noreferrer">
              <div class="reading-art">
                <Picture
                  src={card.art}
                  alt=""
                  widths={[400, 800]}
                  sizes="(min-width: 1024px) 388px, (min-width: 768px) 50vw, calc(100vw - 48px)"
                  formats={['webp']}
                  fallbackFormat="webp"
                  quality={80}
                  loading="lazy"
                />
              </div>
              <div class="reading-body">
                <p class="eyebrow reading-meta">
                  <span>{card.event.category}</span><span class="reading-dot" aria-hidden="true"></span><time datetime={card.event.date}>{formatShort(card.event.date)}</time>
                </p>
                <h3 class="reading-title">{card.title}</h3>
                <p class="reading-summary">{card.summary}</p>
                <p class="reading-source">{card.event.source}&nbsp;<span aria-hidden="true">↗</span><span class="visually-hidden"> (opens in a new tab)</span></p>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Closing call to action -->
  <section class="closing" data-section="Stay close to the evidence" aria-labelledby="closing-title">
    <VisualSlot name="closing" tone="dark" />
    <div class="closing-inner">
      <h2 id="closing-title" class="closing-title">Stay close to <em>the evidence</em></h2>
      <p class="closing-lead">Read the sources and keep the open questions in view.</p>
      <div class="closing-actions">
        <a class="button button-cream" href="/latest">Explore latest</a>
        <a class="button button-outline-light" href="/timeline">Browse timeline</a>
      </div>
    </div>
  </section>

  <SectionJump />
</BaseLayout>

<script>
  // "From event to evidence": reading progress through the three step cards.
  // Each card after the first travels from the bottom of the viewport to its
  // resting line: its sticky top on wide screens, just under the pinned visual
  // on narrow ones, under the nav on short landscape screens (visual pinned
  // beside the cards). Half-way along that path it becomes the current card. On
  // narrow screens the cards scroll on under the visual, so a card also takes
  // over once the card before it reaches the resting line: the current card's
  // text never sits under the visual or its fade.
  //
  // The progress (0 at the first card, 2 at the last, continuous) goes to the
  // sequence visual. It follows the cards' travel, rescaled so each switch
  // point lands exactly half-way between two steps (0.5, 1.5) whatever the
  // card spacing: card, chip and layer change together at every size.
  const section = document.querySelector<HTMLElement>('[data-seq]');
  const steps = [...(section?.querySelectorAll<HTMLElement>('[data-seq-step]') ?? [])];
  // the list items: they keep scrolling while a sticky card rests, so their travel stays linear
  const rows = steps.map((step) => step.parentElement ?? step);
  const pin = section?.querySelector<HTMLElement>('.sequence-visual-pin');
  if (section && steps.length) {
    let queued = false;
    let current = -1;
    const clamp01 = (v: number) => Math.min(1, Math.max(0, v));
    const layout = (vh: number) => {
      const card = getComputedStyle(steps[0]);
      if (card.position === 'sticky') return { rest: parseFloat(card.top) || 0, under: false };
      if (pin && getComputedStyle(pin).position === 'sticky') {
        // short landscape: the visual is pinned beside the cards, which rest under the nav
        if (pin.getBoundingClientRect().left >= steps[0].getBoundingClientRect().right) {
          return { rest: parseFloat(getComputedStyle(pin).top) || 0, under: false };
        }
        const clear = parseFloat(getComputedStyle(section).getPropertyValue('--seq-clear-cards')) || 24;
        return { rest: pin.offsetHeight + clear, under: true };
      }
      return { rest: vh * 0.25, under: false };
    };
    const update = () => {
      queued = false;
      const vh = window.innerHeight;
      const { rest, under } = layout(vh);
      const path = Math.max(1, vh - rest);
      const n = steps.length;
      // travel of each card: 0 at the viewport bottom, 1 on the resting line (not clamped)
      const raw = rows.map((row) => (vh - row.getBoundingClientRect().top) / path);
      // where along its travel each card takes over
      const at = raw.map((r, i) => {
        if (i === 0) return 0;
        if (!under) return 0.5;
        const spacing = raw[i - 1] - r;
        return Math.min(0.5, Math.max(0.1, 1 - spacing));
      });
      let active = 0;
      for (let i = 1; i < n; i++) if (raw[i] >= at[i]) active = i;
      // summed travel, now and at each switch point (every card moves by the same amount)
      const travel = (shift: number) => {
        let sum = 0;
        for (let i = 1; i < n; i++) sum += clamp01(raw[i] + shift);
        return sum;
      };
      const now = travel(0);
      const knotX = [0];
      const knotY = [0];
      for (let i = 1; i < n; i++) {
        knotX.push(Math.max(travel(at[i] - raw[i]), knotX[i - 1] + 1e-4));
        knotY.push(i - 0.5);
      }
      knotX.push(Math.max(n - 1, knotX[n - 1] + 1e-4));
      knotY.push(n - 1);
      let progress = n - 1;
      for (let k = 1; k < knotX.length; k++) {
        if (now < knotX[k]) {
          const f = clamp01((now - knotX[k - 1]) / (knotX[k] - knotX[k - 1]));
          progress = knotY[k - 1] + (knotY[k] - knotY[k - 1]) * f;
          break;
        }
      }
      // rounding safety: stay on the active card's side of its switch points
      progress = Math.min(Math.max(progress, active === 0 ? 0 : active - 0.5), active === n - 1 ? n - 1 : active + 0.4999);
      section.dataset.seqProgress = progress.toFixed(4);
      section.dataset.seqActive = String(active);
      if (active !== current) {
        current = active;
        steps.forEach((step, i) => step.toggleAttribute('data-active', i === active));
      }
      section.dispatchEvent(new CustomEvent('seq:progress', { detail: { progress, active } }));
    };
    const queue = () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(update);
      }
    };
    window.addEventListener('scroll', queue, { passive: true });
    window.addEventListener('resize', queue);
    // narrow layout: the pinned visual lets go when the last card reaches the resting line
    const last = steps[steps.length - 1];
    new ResizeObserver(() => {
      section.style.setProperty('--seq-last', `${last.offsetHeight}px`);
      queue();
    }).observe(last);
    update();
  }
</script>

<style>
  .wrap {
    width: 100%;
    max-width: 1512px;
    margin: 0 auto;
    padding-inline: var(--content-gutter);
  }

  .rule {
    margin: 0;
    border: 0;
    border-top: 1px dashed var(--ink-10);
  }

  /* Hero */
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: 780px;
  }

  .hero-visual {
    position: absolute;
    inset: 0 0 0 42%;
    z-index: -1;
  }

  .hero-inner {
    padding-top: 180px;
    padding-bottom: 200px;
  }

  .hero-inner > h1,
  .hero-lead {
    max-width: 720px;
  }

  .hero-lead {
    max-width: 600px;
    margin-top: 32px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 80px;
  }

  /* Featured interview */
  .interview-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 48px;
    padding-block: 80px;
  }

  .interview-media {
    padding: 16px;
  }

  /*
   * A dashed frame holding the artwork and, below it, a caption strip with the
   * running time and the mark. Nothing sits on the artwork but the play button,
   * so the label can never cover a detail of the art at any width.
   */
  .interview-thumb {
    display: block;
    max-width: 537px;
  }

  .thumb-art {
    position: relative;
    display: block;
    aspect-ratio: 537 / 298;
    overflow: hidden;
    background: var(--card-dark-2);
  }

  .thumb-art :global(picture) {
    display: contents;
  }

  .thumb-art :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease-out);
  }

  .interview-thumb:hover :global(img) {
    transform: scale(1.02);
  }

  .thumb-shade {
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / 0.1);
  }

  .thumb-play {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
