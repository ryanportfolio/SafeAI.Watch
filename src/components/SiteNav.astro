---
import Mark from './Mark.astro';

const primary = [
  { href: '/latest', label: 'Latest' },
  { href: '/timeline', label: 'Timeline' },
  { href: '/about', label: 'About' },
];

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const current = (href: string) => (path === href ? 'page' : undefined);
---
<header class="site-nav" data-site-nav>
  <nav aria-label="Primary">
    <a class="nav-brand" href="/" aria-label="SafeAI.watch home" aria-current={current('/')}>
      <Mark size={22} />
      <span class="nav-brand-name">SafeAI.watch</span>
    </a>

    {/* Before the menu in source order so that, below 1024px, Tab goes from the button
        straight into the menu it opens. Hidden on wider screens, where the links sit inline. */}
    <button
      class="nav-toggle"
      type="button"
      aria-controls="site-menu"
      aria-expanded="false"
      aria-label="Open menu"
      data-nav-toggle
    >
      <span class="burger" aria-hidden="true"><span></span></span>
    </button>

    <ul class="nav-links" id="site-menu">
      {primary.map((item) => (
        <li><a class="nav-link" href={item.href} aria-current={current(item.href)}>{item.label}</a></li>
      ))}
    </ul>
  </nav>
</header>

<style>
  /* One solid bar: page content stops at its dashed rule instead of showing through. */
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--nav-h);
    border-bottom: 1px dashed var(--grey-dash);
    background: var(--paper);
  }

  .site-nav nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    height: 100%;
    padding: 0 35px;
  }

  /* The wordmark face from the logo: Newsreader 420. Its serifed capital I keeps
     "SafeAI" from reading "SafeAl", which Geist's plain I does. */
  .nav-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
  }

  .nav-brand :global(svg) {
    flex: none;
  }

  .nav-brand-name {
    font-family: var(--font-serif);
    font-size: 22px;
    font-weight: 420;
    line-height: 1;
    letter-spacing: -0.008em;
    white-space: nowrap;
  }

  .nav-links {
    display: flex;
    gap: 32px;
  }

  .nav-link {
    display: block;
    padding: 6px 0;
    font-size: 15px;
    font-weight: 500;
    line-height: 21px;
    white-space: nowrap;
    color: var(--ink-64);
    text-decoration: underline 1px transparent;
    text-underline-offset: 7px;
    transition:
      color 0.2s var(--ease-out),
      text-decoration-color 0.2s var(--ease-out);
  }

  .nav-link:hover {
    color: var(--ink);
  }

  .nav-link[aria-current='page'] {
    color: var(--ink);
    text-decoration-color: currentColor;
  }

  .nav-toggle {
    display: none;
  }

  /*
   * Narrow screens: once the inline script below has run (data-menu), the links fold into a
   * menu that drops below the bar. Without it the links stay visible on a second row.
   */
  @media (max-width: 1023px) {
    .site-nav nav {
      padding: 0 var(--content-gutter);
    }

    .nav-brand-name {
      font-size: 20px;
    }

    .site-nav:not([data-menu]) {
      height: auto;
      min-height: var(--nav-h);
    }

    .site-nav:not([data-menu]) nav {
      flex-wrap: wrap;
      row-gap: 2px;
      padding-block: 10px;
    }

    .site-nav:not([data-menu]) .nav-links {
      gap: 24px;
    }

    .site-nav[data-menu] .nav-toggle {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      margin-right: -12px;
      padding: 0;
      border: 0;
      background: none;
      cursor: pointer;
    }

    .burger,
    .burger::before,
    .burger::after,
    .burger span {
      display: block;
    }

    .burger {
      position: relative;
      width: 18px;
      height: 16px;
    }

    .burger::before,
    .burger::after,
    .burger span {
      content: '';
      position: absolute;
      left: 0;
      width: 18px;
      height: 1px;
      background: var(--ink);
      transition:
        transform 0.2s var(--ease-out),
        opacity 0.15s var(--ease-out);
    }

    .burger::before {
      top: 3px;
    }

    .burger span {
      top: 8px;
    }

    .burger::after {
      top: 13px;
    }

    .site-nav.is-open .burger::before {
      transform: translateY(5px) rotate(45deg);
    }

    .site-nav.is-open .burger span {
      opacity: 0;
    }

    .site-nav.is-open .burger::after {
      transform: translateY(-5px) rotate(-45deg);
    }

    .site-nav[data-menu] .nav-links {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      gap: 0;
      padding: 4px var(--content-gutter) 12px;
      border-bottom: 1px dashed var(--grey-dash);
      background: var(--paper);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-6px);
      transition:
        opacity 0.2s var(--ease-out),
        transform 0.2s var(--ease-out),
        visibility 0s linear 0.2s;
    }

    .site-nav[data-menu] .nav-links li + li {
      border-top: 1px dashed var(--grey-rule);
    }

    .site-nav[data-menu] .nav-link {
      padding: 12px 0;
      font-size: 17px;
    }

    .site-nav.is-open .nav-links {
      opacity: 1;
      visibility: visible;
      transform: none;
      transition:
        opacity 0.2s var(--ease-out),
        transform 0.2s var(--ease-out),
        visibility 0s;
    }
  }
</style>

{/* Inline, so it runs as the parser reaches it: the menu collapses before the page below
    paints, and the links never depend on the script bundle loading. */}
<script is:inline>
  (() => {
    const nav = document.querySelector('[data-site-nav]');
    const toggle = nav?.querySelector('[data-nav-toggle]');

    if (nav && toggle) {
      nav.dataset.menu = '';

      const setOpen = (open) => {
        nav.classList.toggle('is-open', open);
        toggle.setAttribute('aria-expanded', String(open));
        toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      };

      toggle.addEventListener('click', () => setOpen(!nav.classList.contains('is-open')));

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && nav.classList.contains('is-open')) {
          setOpen(false);
          toggle.focus();
        }
      });

      document.addEventListener('click', (event) => {
        const target = event.target;
        if (nav.classList.contains('is-open') && !nav.contains(target)) setOpen(false);
      });

      // Tabbing out of the menu closes it, so the open panel never sits over the next focused link.
      const menu = nav.querySelector('#site-menu');
      nav.addEventListener('focusout', (event) => {
        const next = event.relatedTarget;
        if (nav.classList.contains('is-open') && next && next !== toggle && !menu?.contains(next)) setOpen(false);
      });
    }
  })();
</script>
