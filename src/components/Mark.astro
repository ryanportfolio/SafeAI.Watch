---
// SafeAI.watch mark, G3 "Valley · Marker". Both forms are built by
// scripts/brand/build-brand.mjs (npm run brand); never edit the SVGs by hand.
// Below 48px the contours fill in, so small sizes inline the small form (the ink sheet
// with the valley cut out, ink from currentColor); 48px and up load the full mark.
import smallSvg from '../assets/brand/mark-small.svg?raw';
import fullUrl from '../assets/brand/mark.svg?url';

interface Props {
  size?: number;
  class?: string;
  title?: string;
}
const { size = 16, class: className, title } = Astro.props;
const small = size < 48;
const attr = (s: string) => s.replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');
const a11y = title ? ` role="img" aria-label="${attr(title)}"` : ' aria-hidden="true"';
const inline = small
  ? smallSvg
      .trim()
      .replace(
        '<svg xmlns="http://www.w3.org/2000/svg"',
        `<svg${className ? ` class="${attr(className)}"` : ''} width="${size}" height="${size}" focusable="false"${a11y}`,
      )
  : '';
---
{small ? (
  <Fragment set:html={inline} />
) : (
  <img class={className} src={fullUrl} width={size} height={size} alt={title ?? ''} loading="lazy" decoding="async" />
)}
